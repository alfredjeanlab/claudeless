# Capture extended thinking dialog mid-conversation.
# Opens thinking dialog after a response to show mid-conversation state.
# Requires API call - sends a simple question to Haiku.
# Args: --model haiku
# Timeout: 120

wait "─\n❯" 10s
wait 1s

# Send a simple prompt that won't trigger tool use
send "What is 2+2? Just give me the number." 1000 <Enter>

# Wait for response to complete
wait "esc to interrupt" 30s
wait !"esc to interrupt" 30s

# Small delay to ensure UI is settled
wait 500

# Open thinking dialog (Meta+T / Option+T)
send <M-t>
wait "thinking" 3s
snapshot "thinking_dialog_mid_conversation"

# Close dialog and exit
send <Esc> 100 <C-u> 100 "/exit" 100 <Enter>
wait 500
kill TERM
